# 소셜 로그인 키 (각 제공자 콘솔에서 발급 → docs/SOCIAL_LOGIN_SETUP.md 참고)
# 실제 값을 넣은 .env 파일은 git에 올라가지 않음 (.gitignore)

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao (REST API 키)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT secret (실서비스는 반드시 변경)

JWT_SECRET=promptune-dev-secret-key-change-in-production-please

# S3 (문서 파일 저장)
# 로컬에서 문서 업로드 테스트하려면 ~/.aws/credentials 등에 자격증명이 있어야 함
# (EC2에서는 IAM 역할로 자동 인증되므로 액세스 키를 여기 넣지 않음)
AWS_REGION=ap-northeast-2
AWS_S3_DOCUMENTS_BUCKET=promptune-document

# AI Model Mode
# 기본값은 팀원 일반 개발용 Mock 환경
USE_REAL_MODELS=false

# Stage 5 - KcELECTRA 8요소 진단
USE_REAL_DIAGNOSIS=false

# Stage 5 - Bareun 맞춤법 검사
USE_REAL_SPELLCHECK=false
BAREUN_API_KEY=
BAREUN_API_URL=https://api.bareun.ai

# Microsoft Entra ID / Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/integrations/microsoft/callback
MICROSOFT_FRONTEND_URL=http://localhost:3000
MICROSOFT_TOKEN_KEY=

# HyperCLOVA X SEED - Stage 7 local reranker
USE_REAL_SUGGESTION=false
USE_REAL_GENERATION=false
HF_TOKEN=
HF_HCX_MODEL=naver-hyperclovax/HyperCLOVAX-SEED-Vision-Instruct-3B
# auto: CUDA가 보이면 GPU, 아니면 CPU. T4에서는 dtype auto가 float16을 선택.
HF_HCX_DEVICE=auto
HF_HCX_DTYPE=auto

# Internal RAG / BGE-M3
# 실제 파일/파일관리 문서 분석을 테스트할 때 반드시 true.
USE_REAL_RETRIEVAL=true
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=auto
BGE_M3_USE_FP16=auto
BGE_M3_BATCH_SIZE=4

# Tavily Web Search
TAVILY_API_KEY=
