# Nginx 리버스 프록시 설정 템플릿.
# 컨테이너 기동 시 nginx 공식 이미지가 ${DOMAIN} 을 실제 값으로 치환해서
# /etc/nginx/conf.d/default.conf 로 만들어줌 (별도 작업 불필요).
#
# 구조: 80번은 ACME 챌린지 + 443으로 리다이렉트, 443이 실제 트래픽을 처리.
# /api, /login, /oauth2 는 backend로, 나머지는 frontend로 보냄 — 프론트/백엔드가
# 같은 도메인(오리진)을 쓰게 되어 CORS 신경쓸 일이 줄어듦.

server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 20m;

    # 2026-08-25: /api/execute는 real HyperCLOVA X 답변 생성(USE_REAL_GENERATION)이
    # CPU에서 최대 768토큰까지 순차 생성하느라 60초(nginx 기본 timeout)를 넘기는 경우가
    # 있어서, 응답을 다 만들어놓고도(backend/ai-service 로그엔 200 OK) nginx가 먼저
    # 504로 끊어버리는 문제가 있었음. exact match(=)라서 아래 일반 /api/ 블록보다
    # 우선 적용됨 — 이 경로만 넉넉하게 늘리고 나머지 /api/*는 기존 60초 유지.
    location = /api/execute {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Spring Security OAuth2 로그인 관련 경로 — backend로
    location ^~ /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;

        # /api/execute가 HCX 생성+validate까지 포함해 nginx 기본 타임아웃(60초)을
        # 넘기는 경우가 있어 504가 발생함 (2026-08-25 확인). 실제 처리시간 기준으로
        # 넉넉하게 설정. 근본 원인(AI 처리 속도)은 별도로 승득님이 확인 중.
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location ^~ /login {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location ^~ /oauth2/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }

    location = /health {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
    }

    # 그 외 전부 프론트로
    location / {
        proxy_pass http://frontend:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}
