# PrompTune 배포용 환경변수 (EC2에서 사용)
# 이 파일을 .env.production 으로 복사하고 실제 값을 채우세요.
# .env.production 은 git에 안 올라갑니다 (.gitignore 처리됨)
#
# "SSM 관리"라고 표시된 항목은 여기 평문으로 채우지 마세요. AWS SSM Parameter Store
# (/promptune/prod/<KEY>, SecureString)에 등록해두고, 배포 시 scripts/fetch-secrets.sh가
# 자동으로 채워 넣습니다. 로컬 개발용으로만 쓸 거면 여기 직접 값을 넣어도 됩니다.
# 자세한 내용은 docs/EC2_배포_가이드.md 5-1절 참고.

# ── RDS (이미 배포한 AWS RDS) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://promptune-db.cxwue8u66qin.ap-northeast-2.rds.amazonaws.com:5432/promptune
SPRING_DATASOURCE_USERNAME=promptune
SPRING_DATASOURCE_PASSWORD=<RDS_비밀번호>   # SSM 관리

# ── 배포 도메인 (Nginx + HTTPS 기준. docs/EC2_배포_가이드.md 5-2절 참고) ──
# EC2 퍼블릭 IP를 그대로 쓰려면 nip.io 무료 서비스로 도메인처럼 쓸 수 있음
# (가입 불필요, <IP를-대시로-바꾼값>.nip.io 형태로 자동 resolve됨).
# 예: EC2 IP가 12.34.56.78 이면 DOMAIN=12-34-56-78.nip.io
# 프론트/백엔드가 이제 같은 도메인(Nginx가 경로별로 분배)을 쓰므로 포트 번호는 안 붙임.
DOMAIN=<배포도메인>
APP_FRONTEND_URL=https://<배포도메인>
APP_CORS_ORIGINS=https://<배포도메인>
NEXT_PUBLIC_API_URL=https://<배포도메인>
OAUTH_REDIRECT_BASE=https://<배포도메인>

# ── JWT (운영용으로 반드시 변경) ──
JWT_SECRET=<32자-이상-랜덤-문자열>   # SSM 관리

# ── S3 (문서 파일 저장) ──
# 액세스 키는 여기 안 넣습니다 — EC2 인스턴스에 붙인 IAM 역할(promptune-ec2-s3-role)에서
# 자동으로 자격증명을 가져오도록 되어있습니다 (backend/src/main/java/com/promptune/config/S3Config.java 참고).
AWS_REGION=ap-northeast-2
AWS_S3_DOCUMENTS_BUCKET=promptune-document

# ── 소셜 로그인 키 (있으면) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=   # SSM 관리
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=   # SSM 관리
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=   # SSM 관리

# ── AI 모델 스위치 (배포 초기엔 false=mock 권장, 메모리 절약) ──
USE_REAL_MODELS=false
USE_REAL_DIAGNOSIS=false
USE_REAL_SPELLCHECK=false
USE_REAL_SUGGESTION=false
# 답변 생성(1:1 문의)만 real HyperCLOVA X로 켜는 스위치. 로컬에 1.5B 파라미터
# 모델을 통째로 로드하므로(외부 API 아님) 최소 8GB+ RAM 인스턴스에서만 true로.
USE_REAL_GENERATION=false
USE_REAL_VALIDATION=false
HF_TOKEN=   # SSM 관리, HuggingFace 모델 접근용 read 토큰
TAVILY_API_KEY=   # SSM 관리, 웹검색(retrieval-execute) 연동용. app.tavily.com에서 발급

# ── Microsoft 연동 (있으면) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=   # SSM 관리
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://<배포도메인>/api/integrations/microsoft/callback
MICROSOFT_FRONTEND_URL=https://<배포도메인>
MICROSOFT_TOKEN_KEY=   # SSM 관리
